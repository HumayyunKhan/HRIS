{
  "name": "emr-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js",
    "create-migration": "typeorm migration:create -d src/database/migrations -n",
    "run-migrations": "npm run typeorm migration:run",
    "revert-migrations": "npm run typeorm migration:revert",
    "generate-migrations": "node --require ts-node/register ./node_modules/typeorm/cli.js migration:generate -n generated -d ./src/database/migrations -p",
    "precommit": "lint-staged",
    "local-serve": "node src/main.ts",
    "local-serve-sls": "sls offline --config ./serverless.dev.yml --stage dev --verbose",
    "sls-build": "sls webpack --config ./serverless.prod.yml --stage prod --verbose",
    "dev-deploy": "npx sls deploy --config ./serverless.dev.yml --stage dev --verbose",
    "dev-deploy-fn": "sls deploy function -f main --config ./serverless.dev.yml --stage dev --verbose",
    "prod-push-app-config": "aws s3 cp ./app/config s3://swiftmd-public-assets/app/config --recursive --profile veinmd --acl public-read",
    "prod-deploy": "sls deploy --config ./serverless.prod.yml --stage prod --verbose",
    "prod-deploy-fn": "sls deploy function -f main --config ./serverless.prod.yml --stage prod --verbose"
  },
  "dependencies": {
    "@nestjs/axios": "^0.0.4",
    "@nestjs/common": "^8.0.0",
    "@nestjs/config": "^1.1.6",
    "@nestjs/core": "^8.0.0",
    "@nestjs/jwt": "^8.0.0",
    "@nestjs/passport": "^8.0.0",
    "@nestjs/platform-express": "^8.0.0",
    "@nestjs/swagger": "^5.0.4",
    "@nestjs/terminus": "^8.0.4",
    "@nestjs/typeorm": "^8.0.3",
    "@sendgrid/mail": "^7.7.0",
    "@serverless-chrome/lambda": "^1.0.0-57.2",
    "@types/lodash": "^4.14.182",
    "add": "^2.0.6",
    "aws-lambda": "^1.0.7",
    "bcrypt": "^5.0.1",
    "chrome-aws-lambda": "^10.1.0",
    "class-transformer": "0.4.0",
    "class-validator": "^0.13.1",
    "googleapis": "^123.0.0",
    "handlebars": "^4.7.7",
    "helmet": "^4.6.0",
    "joi": "^17.6.0",
    "mysql": "^2.18.1",
    "mysql2": "^2.3.3",
    "nest-winston": "^1.5.0",
    "passport": "^0.4.1",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^10.0.0",
    "puppeteer-core": "^10.1.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "serverless-http": "^3.0.1",
    "swagger-ui-express": "^4.1.6",
    "typeorm": "^0.2.41",
    "validate-date": "^2.0.0",
    "winston": "^3.3.3",
    "winston-daily-rotate-file": "^4.5.5",
    "word-wrap": "^1.2.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^8.0.0",
    "@nestjs/schematics": "^8.0.0",
    "@nestjs/testing": "^8.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.13",
    "@types/jest": "27.0.2",
    "@types/mysql": "^2.15.21",
    "@types/mysql-import": "^2.0.1",
    "@types/node": "^16.0.0",
    "@types/passport-jwt": "^3.0.6",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^7.0.4",
    "jest": "^27.2.5",
    "lint-staged": "^12.3.3",
    "mysql-import": "^5.0.21",
    "prettier": "^2.3.2",
    "serverless": "^2.70.0",
    "serverless-lift": "^1.9.1",
    "serverless-offline": "^6.1.5",
    "serverless-plugin-optimize": "^4.1.4-rc.1",
    "serverless-plugin-warmup": "^4.9.0",
    "serverless-step-functions": "^3.1.0",
    "serverless-webpack": "^5.3.5",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "^27.0.3",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^3.10.1",
    "tsconfig-paths-webpack-plugin": "^3.2.0",
    "typescript": "^4.3.5",
    "webpack": "^5.73.0",
    "webpack-node-externals": "^1.7.2"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
    ],
    "{src,test}/**/*.{ts,json}": [
      "yarn run format"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
